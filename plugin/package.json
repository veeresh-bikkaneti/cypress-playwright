{
  "name": "cypress2playwright-using-ai",
  "version": "1.0.0",
  "description": "AI-powered Cypress to Playwright migration toolkit. Installable plugin for GitHub Copilot, Claude Code, Cursor, Cline, Windsurf, Aider, and Continue.",
  "main": "lib/index.js",
  "bin": {
    "cypress2playwright-setup": "./bin/setup.js"
  },
  "scripts": {
