{
  "name": "cypress2playwright-using-ai",
  "version": "1.1.0",
  "description": "Cypress-to-Playwright migration toolkit. Portable AGENTS.md + skills for GitHub Copilot, Claude Code, Cursor, Grok, OpenAI Codex, Gemini, and OpenCode.",
  "main": "lib/index.js",
  "bin": {
    "cypress2playwright-setup": "./bin/setup.js"
  },
  "scripts": {
    "setup": "node bin/setup.js",
    "test": "node bin/setup.js list && node scripts/smoke-setup.js && node scripts/audit-skills.js",
    "audit:urls": "node scripts/audit-template-urls.js",
    "audit:urls:verbose": "node scripts/audit-template-urls.js --verbose"
  },
  "keywords": [
    "cypress",
    "playwright",
    "migration",
    "ai",
    "copilot",
    "claude",
    "cursor",
    "grok",
    "codex",
    "gemini",
    "opencode",
    "agents.md",
    "testing",
    "e2e"
  ],
  "author": "Veeresh Bikkaneti",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/veeresh-bikkaneti/cypress-playwright"
  },
  "homepage": "https://github.com/veeresh-bikkaneti/cypress-playwright#readme",
  "bugs": {
    "url": "https://github.com/veeresh-bikkaneti/cypress-playwright/issues"
  },
  "files": [
    "bin/",
    "lib/",
    "templates/",
    "README.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
