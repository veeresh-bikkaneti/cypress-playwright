    "audit:urls": "node scripts/audit-template-urls.js",
    "audit:urls:verbose": "node scripts/audit-template-urls.js --verbose"
  },
  "keywords": [
    "cypress",
    "playwright",
    "migration",
    "ai",
    "copilot",
    "claude",
    "cursor",
    "cline",
    "windsurf",
    "aider",
    "continue",
    "testing",
    "e2e",
    "automation"
  ],
  "author": "Veeresh Bikkaneti",
